{
    "Title": "Cuestionario de calidad de vida y síntomas de tracto urinario inferior (ICIQ-LUTSqol)",
    "TimeoutFocus": 150,
    "TimeoutFocusResult": 450,
    "AboutCalculator": [
        {
            "Title": "Descripción",
            "ContentHtmlString": "El ICIQ-LUTSqol es una herramienta que permite evaluar el impacto de los síntomas del tracto urinario inferior en la vida de los pacientes y puede usarse para valorar diferentes modalidades de tratamiento."
        },
        {
            "Title": "Referencias",
            "ContentHtmlString": "<ion-item><ion-label class=\"ion-text-justify\"><p class=\"references\">1. International Consultation on Incontinence Questionnaire Lower Urinary Tract Symptoms Quality of Life Module (ICIQ-LUTSqol) [Internet]. (consultado el 24 de abril del 2024). Disponible en: <a class=\"link\" (click)=\"inAppBrowser(https://iciq.net/iciq-lutsqol )\">https://iciq.net/iciq-lutsqol </a></p></ion-label></ion-item>"
        }
    ],
    "Definition": [
        {
            "Type": "Indications",
            "Label": "<p style=\"h1 {color: #002e6d; text-align: center; font-size: 1.75rem}\">Use esta calculadora para evaluar la calidad de vida de los pacientes con síntomas en el tracto urinario inferior. Proporcione a su paciente el dispositivo para que responda o lea usted las preguntas y sus opciones.</p>"
        }
    ],
