{
  "Title": "Cuestionario de deficiencia androgénica en el varón adulto (qADAM)",
  "TimeoutFocus": 150,
  "TimeoutFocusResult": 450,
  "AboutCalculator": [
    {
      "Title": "Descripción",
      "ContentHtmlString": "El cuestionario qADAM es una herramienta diseñada para evaluar la presencia y severidad de síntomas asociados a la deficiencia androgénica en varones adultos. A diferencia de la versión original, este nuevo formato cuantitativo permite graduar la intensidad de los síntomas, lo que facilita el seguimiento clínico y la evaluación de la respuesta al tratamiento."
    },
    {
      "Title": "Referencias",
      "ContentHtmlString": "<ion-item><ion-label class=\"ion-text-justify\"><p class=\"references\">1) James HE. Neurologic evaluation and support in the child with an acute brain insult. Pediatr Ann. 1986 Jan;15(1):16–22.</p></ion-label></ion-item><ion-item><ion-label class=\"ion-text-justify\"><p class=\"references\">2) Borgialli DA, Mahajan P, Hoyle JD, Powell EC, Nadel FM, Tunik MG, et al. Performance of the Pediatric Glasgow Coma Scale Score in the Evaluation of Children With Blunt Head Trauma. Acad Emerg Med. 2016 Aug;23(8):878–84.</p></ion-label></ion-item>"
    }
  ],
  "Definition": [
    {
      "Type": "Indications",
      "Label": "<p style=\"h1 {color: #002e6d; text-align: center; font-size: 1.75rem}\">Use este cuestionario para evaluar la presencia y severidad de los síntomas asociados a la deficiencia androgénica en varones adultos. Proporcione a su paciente el dispositivo para que pueda responder, o lea usted las preguntas junto a sus opciones de respuesta</p>"
    }],
